<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.craxiom.networksurvey.fragments.model.BluetoothViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".fragments.BluetoothFragment">

        <!-- 蓝牙页 UI 已整体 Compose 化（ui/bluetooth/BluetoothListScreen），
             顶部状态条（设备数/扫描状态/排序/暂停）已并入 Compose。
             保留 CoordinatorLayout 供 Snackbar 与权限提示挂载。 -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/bluetooth_list_compose_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>